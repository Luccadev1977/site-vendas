NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only on a trusted server (optional email worker). Edge runtime injects its own service role.
# Never add this variable to GitHub Pages or any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Optional SMTP provider for project notifications. Auth SMTP is configured in Supabase.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CRON_SECRET=
PRIVACY_CONTACT_EMAIL=
