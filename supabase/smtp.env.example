# Optional CLI setup only. The recommended setup is directly in Supabase Auth.
# Copy to supabase/.env.smtp.local (ignored), and fill privately after verification.
# Never load this file in Next.js, GitHub Pages or Repository Variables.
SUPABASE_AUTH_SMTP_HOST=
SUPABASE_AUTH_SMTP_USER=
SUPABASE_AUTH_SMTP_PASSWORD=
SUPABASE_AUTH_SMTP_FROM_EMAIL=
